# Template only: provide real values locally, never commit secrets.
NODE_ENV=production
BACKEND_HTTP_PORT=8180
AUTH_POSTGRES_URL=
AUTH_POSTGRES_POOL_SIZE=10
AUTH_POSTGRES_CONNECT_TIMEOUT_MS=5000
AUTH_POSTGRES_STATEMENT_TIMEOUT_MS=5000
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
CSRF_ENABLED=true
CSRF_SECRET=
CSRF_COOKIE_SECURE=true
AUTH_EXPOSE_RESET_TOKEN=false
REQUEST_FRESHNESS_ENABLED=true
REQUEST_TIMESTAMP_HEADER=x-request-timestamp
REQUEST_MAX_AGE_MS=300000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Optional add-only import; requires migration 003, never applies it automatically.
ASSET_IMPORT_ENABLED=false

# Optional purchase/warranty dates; migration 004 must be applied separately.
ASSET_DATES_ENABLED=false

# Optional date-preserving import v2; requires import + dates flags and migrations 001-004.
ASSET_IMPORT_V2_ENABLED=false

# Optional manual locations; migration 005 must be applied separately.
ASSET_LOCATION_ENABLED=false

# Optional location-aware export; requires dates and location enabled.
ASSET_EXPORT_V3_ENABLED=false

# Optional location/date-preserving import; requires import, dates, location and migrations 001-005.
ASSET_IMPORT_V3_ENABLED=false

# Optional filtered export; requires dates/location and existing migrations 001-005.
ASSET_SELECTION_EXPORT_ENABLED=false
